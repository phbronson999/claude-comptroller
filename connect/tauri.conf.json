{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "claude-comptroller-connect",
  "version": "0.2.0",
  "identifier": "io.github.claude-comptroller.connect",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "claude-comptroller",
        "width": 360,
        "height": 560,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
