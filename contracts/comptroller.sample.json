{
  "General": {
    "OrganizationName": ""
  },
  "Proxy": {
    "ListenUrl": "http://localhost:8080",
    "AdminPort": 8081,
    "UpstreamUrl": "https://api.anthropic.com",
    "ActivityTimeoutMinutes": 10,
    "ShutdownTimeoutSeconds": 60,
    "StripForwardedHeaders": true
  },
  "Access": {
    "AllowedCidrs": [
      "127.0.0.1/32",
      "::1/128"
    ]
  },
  "Identity": {
    "Mode": "windows",
    "AllowedGroup": "Claude Code Users",
    "TokenLifetimeDays": 7,
    "CodeLifetimeHours": 24,
    "TokenHeaderName": "X-Comptroller-Token"
  },
  "Data": {
    "Folder": "data",
    "RetentionDays": 14,
    "PruneTime": "02:00"
  },
  "Logging": {
    "Folder": "logs",
    "Level": "Information",
    "RetainedFiles": 14,
    "FileSizeLimitMb": 20
  },
  "Cost": {
    "Currency": "$",
    "MonthStartDay": 1,
    "PricingFile": "pricing.json",
    "SeatPlans": [
      { "Name": "Team standard", "Billing": "annual", "Price": null, "RenewalDate": null }
    ]
  },
  "Dashboard": {
    "RefreshSeconds": 2,
    "P95WarningSeconds": 10,
    "ErrorRateWarningPercent": 5
  },
  "TLS": {
    "CertificateThumbprint": "",
    "CertificateStore": "LocalMachine"
  },
  "Archives": {
    "Folder": "data\\archives",
    "DefaultContent": "summary",
    "Baseline": ""
  }
}
